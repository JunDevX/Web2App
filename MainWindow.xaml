<Window x:Class="Web2AppLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор Web2App" Height="480" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Cоздание Web2App Приложения" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- URL -->
            <TextBlock Text="URL Адрес:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtUrl" Margin="0,5,0,15" Padding="6" TextChanged="TxtUrl_TextChanged"/>

            <!-- Название -->
            <TextBlock Text="Название приложения:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtName" Margin="0,5,0,15" Padding="6"/>

            <!-- Иконка -->
            <TextBlock Text="Иконка (.ico или .png):" FontWeight="SemiBold"/>
            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtIcon" Padding="6" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Обзор..." Width="80" Margin="10,0,0,0" Click="BtnBrowseIcon_Click"/>
            </Grid>

            <!-- UserAgent -->
            <TextBlock Text="User-Agent:" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtUserAgent" Margin="0,5,0,20" Padding="6" 
                     Text="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"/>

            <!-- Кнопка сборки -->
            <Button Content="Создать Web2App Приложение" Height="42" Background="#007ACC" Foreground="White" 
                    FontWeight="Bold" FontSize="14" Click="BtnCreate_Click"/>
        </StackPanel>
    </Grid>
</Window>